{
  "name": "markdown-wysiwyg-pdf",
  "displayName": "Markdown WYSIWYG + PDF",
  "description": "Edit Markdown as it looks, in the same tab (Typora-like). Keeps your original formatting, with read-only mode and PDF export. / Markdown を見たまま同じタブで編集。閲覧モードと PDF 出力に対応。",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "version": "0.3.0",
  "publisher": "takagamba",
  "license": "MIT",
  "author": "takagamba",
  "repository": {
    "type": "git",
    "url": "https://github.com/takagamba/md-wysiwyg-editor.git"
  },
  "bugs": {
    "url": "https://github.com/takagamba/md-wysiwyg-editor/issues"
  },
  "homepage": "https://github.com/takagamba/md-wysiwyg-editor#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "wysiwyg",
    "editor",
    "typora",
    "vditor",
    "pdf",
    "mermaid",
    "katex",
    "japanese"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdWysiwyg.vditor",
        "displayName": "Markdown を見たまま編集",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mdWysiwyg",
          "title": "Markdown WYSIWYG",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "mdWysiwyg": [
        {
          "id": "mdWysiwyg.headings",
          "name": "見出し",
          "icon": "media/activitybar.svg",
          "when": "activeCustomEditorId == mdWysiwyg.vditor"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mdWysiwyg.headings",
        "contents": "この文書には見出しがありません。\n`#` で始まる行が見出しになります。"
      }
    ],
    "commands": [
      {
        "command": "mdWysiwyg.enterReadOnly",
        "title": "閲覧モードにする",
        "category": "Markdown WYSIWYG",
        "icon": "$(lock)"
      },
      {
        "command": "mdWysiwyg.exitReadOnly",
        "title": "編集モードにする",
        "category": "Markdown WYSIWYG",
        "icon": "$(unlock)"
      },
      {
        "command": "mdWysiwyg.toggleReadOnly",
        "title": "閲覧 / 編集モードを切り替え",
        "category": "Markdown WYSIWYG"
      },
      {
        "command": "mdWysiwyg.exportPdf",
        "title": "PDF に出力",
        "category": "Markdown WYSIWYG",
        "icon": "$(file-pdf)"
      },
      {
        "command": "mdWysiwyg.openWysiwyg",
        "title": "Markdown を見たまま編集",
        "icon": "$(preview)"
      },
      {
        "command": "mdWysiwyg.openAsText",
        "title": "テキストエディタで開く",
        "category": "Markdown WYSIWYG",
        "icon": "$(file-code)"
      },
      {
        "command": "mdWysiwyg.setDefaultEditor",
        "title": "*.md を開く既定のエディタを設定",
        "category": "Markdown WYSIWYG"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdWysiwyg.enterReadOnly",
          "when": "activeCustomEditorId =~ /^mdWysiwyg\\./ && !mdWysiwyg.readOnly",
          "group": "navigation@1"
        },
        {
          "command": "mdWysiwyg.exitReadOnly",
          "when": "activeCustomEditorId =~ /^mdWysiwyg\\./ && mdWysiwyg.readOnly",
          "group": "navigation@1"
        },
        {
          "command": "mdWysiwyg.exportPdf",
          "when": "activeCustomEditorId =~ /^mdWysiwyg\\./ || editorLangId == markdown",
          "group": "navigation@2"
        },
        {
          "command": "mdWysiwyg.openAsText",
          "when": "activeCustomEditorId =~ /^mdWysiwyg\\./",
          "group": "navigation@3"
        },
        {
          "command": "mdWysiwyg.openWysiwyg",
          "when": "editorLangId == markdown && !activeCustomEditorId",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "mdWysiwyg.openWysiwyg",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/",
          "group": "navigation@50"
        },
        {
          "command": "mdWysiwyg.exportPdf",
          "when": "resourceExtname =~ /^\\.(md|markdown)$/",
          "group": "navigation@51"
        }
      ],
      "commandPalette": [
        {
          "command": "mdWysiwyg.enterReadOnly",
          "when": "activeCustomEditorId =~ /^mdWysiwyg\\./ && !mdWysiwyg.readOnly"
        },
        {
          "command": "mdWysiwyg.exitReadOnly",
          "when": "activeCustomEditorId =~ /^mdWysiwyg\\./ && mdWysiwyg.readOnly"
        },
        {
          "command": "mdWysiwyg.toggleReadOnly",
          "when": "activeCustomEditorId =~ /^mdWysiwyg\\./"
        },
        {
          "command": "mdWysiwyg.openAsText",
          "when": "activeCustomEditorId =~ /^mdWysiwyg\\./"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mdWysiwyg.toggleReadOnly",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "activeCustomEditorId =~ /^mdWysiwyg\\./"
      }
    ],
    "configuration": {
      "title": "Markdown WYSIWYG",
      "properties": {
        "mdWysiwyg.openByDefault": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "`.md` / `.markdown` ファイルを最初から「Markdown を見たまま編集」で開く。オフにすると VS Code 標準のテキストエディタで開く。\n\n切り替えると、VS Code の `#workbench.editorAssociations#`（ユーザー設定）を書き換える。"
        },
        "mdWysiwyg.readOnlyByDefault": {
          "type": "boolean",
          "default": false,
          "description": "ファイルを開いたときに閲覧モード（読み取り専用）で表示する。"
        },
        "mdWysiwyg.vditor.mode": {
          "type": "string",
          "enum": [
            "ir",
            "wysiwyg",
            "sv"
          ],
          "enumDescriptions": [
            "即時レンダリング（Typora 風。カーソル位置だけ記法を表示）",
            "完全 WYSIWYG",
            "分割ビュー（ソース + プレビュー）"
          ],
          "default": "ir",
          "description": "Vditor の編集モード。"
        },
        "mdWysiwyg.preserveFormatting": {
          "type": "boolean",
          "default": true,
          "description": "保存時、編集していない部分は元の書き方のまま残す。オフにすると Vditor が文書全体を書式を揃えて書き出す（`[x]` → `[X]`、表の列幅揃えなど）。"
        },
        "mdWysiwyg.imageFolder": {
          "type": "string",
          "default": "images",
          "markdownDescription": "貼り付け・ドロップした画像を保存するフォルダ（文書のあるフォルダからの相対パス）。空にすると文書と同じフォルダに保存する。"
        },
        "mdWysiwyg.pdf.browserPath": {
          "type": "string",
          "default": "",
          "description": "PDF 出力に使う Chrome / Edge の実行ファイルのパス。空なら自動検出。"
        },
        "mdWysiwyg.pdf.format": {
          "type": "string",
          "enum": [
            "A4",
            "A3",
            "A5",
            "B5",
            "Letter",
            "Legal"
          ],
          "default": "A4",
          "description": "PDF の用紙サイズ。"
        },
        "mdWysiwyg.pdf.margin": {
          "type": "string",
          "default": "20mm",
          "description": "PDF の余白（上下左右共通。例: 20mm, 1in）。"
        },
        "mdWysiwyg.pdf.pageNumbers": {
          "type": "boolean",
          "default": true,
          "description": "PDF のフッターにページ番号を入れる。"
        },
        "mdWysiwyg.pdf.openAfterExport": {
          "type": "boolean",
          "default": true,
          "description": "PDF 出力後にファイルを開く。"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:vscode": "npm run build && node test/vscode/run.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "npx @vscode/vsce package --no-dependencies",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "puppeteer-core": "^25.12.0",
    "vditor": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
